{
  "_comment": [
    "health-zoo configuration. Copy to /etc/health-zoo.json and edit.",
    "Only hosts are listed here — services, containers, cameras and package",
    "updates are discovered by the agents at runtime, so installing something",
    "new on a server makes it appear on the dashboard without touching this file.",
    "",
    "agent: linux | synology | openwrt | routeros | meshtastic | none",
    "  'none' means network-level probing only (ping + TCP ports).",
    "updatable: show the 'update packages' button for this host.",
    "update_last: update this host after all others (the box hosting the",
    "  dashboard must go last, or it kills its own service mid-run)."
  ],
  "poll_interval": 180,
  "ssh_key": "~/.ssh/id_health_zoo",
